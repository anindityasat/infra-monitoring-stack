# =========================
# IMAGE VERSION (PINNED EXACT MATCH)
# =========================
GRAFANA_IMAGE=grafana/grafana:12.3.2-security-01
PROMETHEUS_IMAGE=prom/prometheus:v3.9.1
LOKI_IMAGE=grafana/loki:3.6.5
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.145.0
NODE_EXPORTER_IMAGE=prom/node-exporter:latest


# =========================
# PORTS
# =========================
PORT_GRAFANA=43000
PORT_PROMETHEUS=49090
PORT_LOKI=43100
